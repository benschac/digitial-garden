[workspace]
provider = "codex"

[providers]
[providers.codex]
base = "builtin:codex"
ready_delay_ms = 0
option_defaults = { model = "gpt-6.1-sol", effort = "high" }

[defaults]
[defaults.rig]
[defaults.rig.imports]
[defaults.rig.imports.gc]
source = "https://github.com/gastownhall/gascity-packs/tree/main/gascity/roles"
version = "sha:3b3b89f2011e06d84459aa7bea1552382f13930a"

# [mail]
# retention_ttl controls how long read messages are retained before purge.
# 0 disables retention; use "168h" for 7 days.
# "7d" is not a valid Go duration.
# It also sets how long a read mail bead stays open before the nudge-mail
# sweep closes it: unset keeps that sweep's own 60m default, while "0"
# disables the close phase too, leaving read mail beads open.
# retention_ttl = "0"

[[rigs]]
name = "personal-site"
default_branch = "main"
[rigs.imports]
[rigs.imports.gc]
source = "https://github.com/gastownhall/gascity-packs/tree/main/gascity/roles"
version = "sha:3b3b89f2011e06d84459aa7bea1552382f13930a"

[rigs.imports.deps]
source = "/Users/benjaminschachter/personal-site/gascity/dependency-updates"

[rigs.imports.skills]
source = "/Users/benjaminschachter/personal-site/gascity/skill-updates"


[[orders.overrides]]
name = "skill-updates"
rig = "personal-site"
enabled = true


[[patches.agent]]
name = "control-dispatcher"
rig = "*"
overlay_dir = "/Users/benjaminschachter/personal-site-city/.gc/overlays/codex-current-hooks"

