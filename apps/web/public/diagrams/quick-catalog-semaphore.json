            "code-trace": [
              {
                "type": "text",
                "text": "**A: acquire, then call the task**"
              },
              {
                "type": "code",
                "text": "  01  const permits = Semaphore.makeUnsafe(2);\n  02  const executeTask = Effect.tryPromise({\n▶ 03    try: async () => task(context),\n  04    catch: (error) => error,\n  05  });\n▶ 06  const program = permits.withPermit(executeTask);\n  07  Effect.runPromise(program);"
              },
              {
                "type": "text",
                "text": "Permits held: 1 / 2 · Task calls: A = 1, B = 0, C = 0"
              },
              {
                "type": "subtitle",
                "text": "runPromise starts the program. withPermit admits A; only then does the tryPromise factory call task(context)."
              }
            ]
          },
          "light": ["one", "waiting"]
        },
        {
          "edges": {
            "edge": "take-two",
