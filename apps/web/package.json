{
  "name": "@personal-site/web",
  "version": "0.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build",
    "content:validate": "content-collections build",
    "dev": "next dev",
    "eve:build": "eve build",
    "eve:dev": "eve dev",
    "eve:info": "eve info",
    "lint": "biome lint .",
    "test": "bun run content:validate && bun test",
    "check-types": "bun run content:validate && tsc --noEmit",
    "wasm:build": "CARGO_TARGET_DIR=/tmp/personal-site-wasm-target cargo build --manifest-path ../../packages/wasm-canvas-engine/Cargo.toml --target wasm32-unknown-unknown --release && mkdir -p public/wasm && cp /tmp/personal-site-wasm-target/wasm32-unknown-unknown/release/wasm_canvas_engine.wasm public/wasm/particle-engine.wasm",
    "wasm:dev": "bun run --parallel --no-orphans dev wasm:watch",
    "wasm:setup": "rustup target add wasm32-unknown-unknown",
    "wasm:watch": "bun run scripts/watch-wasm.ts",
    "build:eve": "eve build",
    "dev:eve": "eve dev",
    "start": "next start",
    "start:eve": "eve start",
    "typecheck": "bun run check-types"
  },
  "dependencies": {
    "@content-collections/cli": "^0.1.9",
    "@content-collections/core": "^0.15.2",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/next": "^0.2.11",
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.2",
    "@personal-site/react-hooks": "workspace:*",
    "@personal-site/ui": "workspace:*",
    "@radix-ui/react-use-controllable-state": "1.2.2",
    "@react-three/fiber": "^9.7.0",
    "@shikijs/core": "3.23.0",
    "@shikijs/engine-javascript": "3.23.0",
    "@shikijs/engine-oniguruma": "3.23.0",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@tailwindcss/postcss": "4.3.0",
    "@types/mdx": "2.0.14",
    "ai": "7.0.83",
    "eve": "0.46.0",
    "katex": "^0.18.4",
    "lucide-react": "1.16.0",
    "motion": "12.40.0",
    "nanoid": "5.1.11",
    "next": "16.3.2",
    "pts": "^0.12.9",
    "radix-ui": "1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "^6.0.0",
    "server-only": "0.0.1",
    "shiki": "3.23.0",
    "sql.js": "1.13.0",
    "streamdown": "2.5.0",
    "tailwindcss": "4.3.0",
    "three": "^0.185.1",
    "typegpu": "^0.12.3",
    "use-stick-to-bottom": "1.1.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@shikijs/rehype": "^4.4.3",
    "@types/bun": "1.4.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/sql.js": "1.4.10",
    "@webgpu/types": "^0.1.72",
    "typescript": "7.0.2",
    "unplugin-typegpu": "0.12.2"
  }
}
