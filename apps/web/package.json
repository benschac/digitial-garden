{
  "name": "@personal-site/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "content:validate": "bun run src/lib/content/validate-content.ts",
    "dev": "next dev",
    "lint": "biome lint .",
    "test": "bun test",
    "check-types": "tsc --noEmit",
    "wasm:build": "CARGO_TARGET_DIR=/tmp/personal-site-wasm-target cargo build --manifest-path ../../packages/wasm-canvas-engine/Cargo.toml --target wasm32-unknown-unknown --release && mkdir -p public/wasm && cp /tmp/personal-site-wasm-target/wasm32-unknown-unknown/release/wasm_canvas_engine.wasm public/wasm/particle-engine.wasm",
    "wasm:dev": "bun run --parallel --no-orphans dev wasm:watch",
    "wasm:setup": "rustup target add wasm32-unknown-unknown",
    "wasm:watch": "bun run scripts/watch-wasm.ts"
  },
  "dependencies": {
    "@mdx-js/loader": "3.1.1",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@next/mdx": "16.3.2",
    "@react-three/fiber": "^9.7.0",
    "@types/mdx": "2.0.14",
    "gray-matter": "4.0.3",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rehype-slug": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "three": "^0.185.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@shikijs/rehype": "^4.4.3",
    "@types/bun": "1.4.0",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "typescript": "7.0.2"
  }
}
