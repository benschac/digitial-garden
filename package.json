{
  "name": "personal-site",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "gc start \"$HOME/personal-site-city\" && turbo run dev --ui=stream",
    "build-storybook": "turbo run build-storybook",
    "lint": "turbo run lint lint:root",
    "format": "oxfmt",
    "format:check": "turbo run format:check format:root",
    "check": "turbo run lint lint:root format:check format:root --affected --output-logs=errors-only",
    "check-types": "turbo run check-types check-types:root --affected",
    "check-types:all": "turbo run check-types check-types:root",
    "check-types:effect": "bun run --cwd apps/web typegen && effect-tsgo tsrs@0.20.1-ts7.1.0-beta --project apps/web/tsconfig.json --noEmit --incremental false",
    "content:validate": "turbo run content:validate",
    "test": "turbo run test:content test --affected",
    "test:all": "turbo run test:content test",
    "wasm:build": "turbo run wasm:build --filter=@personal-site/web",
    "wasm:dev": "turbo run wasm:dev --filter=@personal-site/web",
    "wasm:setup": "turbo run wasm:setup --filter=@personal-site/web",
    "wasm:watch": "turbo run wasm:watch --filter=@personal-site/web",
    "lint:fix": "oxlint --fix",
    "test:tools": "node --test scripts/*.test.mjs",
    "verify": "turbo run lint lint:root format:check format:root test:tools patterns:check check-types:root check-types test:content test --affected --output-logs=errors-only",
    "sources:fetch": "node scripts/agent-sources.mjs fetch",
    "sources:check": "node scripts/agent-sources.mjs check",
    "sources:updates": "node scripts/agent-sources.mjs updates",
    "lint:root": "oxlint . --ignore-pattern 'apps/**' --ignore-pattern 'packages/**'",
    "format:root": "oxfmt --check . '!apps/**' '!packages/**'",
    "verify:all": "turbo run lint lint:root format:check format:root test:tools patterns:check check-types:root check-types test:content test --concurrency=4 --output-logs=errors-only",
    "verify:full": "bun run verify:all && turbo run build --concurrency=1 --output-logs=errors-only",
    "patterns": "node scripts/agent-patterns.mjs",
    "patterns:check": "node scripts/agent-patterns.mjs check && node scripts/ratstack-adoption.mjs check",
    "patterns:check-sources": "node scripts/agent-patterns.mjs check-sources",
    "ratstack:adoption": "node scripts/ratstack-adoption.mjs",
    "ratstack:adoption:check": "node scripts/ratstack-adoption.mjs check",
    "check-types:root": "effect-tsgo tsc@7.0.2 --project gascity/tsconfig.json --noEmit --incremental false"
  },
  "devDependencies": {
    "@effect/platform-bun": "4.1.2",
    "@effect/tsgo": "0.63.0",
    "@oxlint/plugins": "1.91.0",
    "@types/node": "24.19.2",
    "effect": "4.1.2",
    "execa": "10.2.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "turbo": "2.11.10",
    "typescript": "7.0.2",
    "ultracite": "8.1.1"
  },
  "overrides": {
    "@effect/platform-node-shared": "4.1.2"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
