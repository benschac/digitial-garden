{
  "name": "personal-site",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "lint": "turbo run lint",
    "format": "node scripts/oxc-tool.mjs fmt",
    "format:check": "node scripts/oxc-tool.mjs fmt --check",
    "check": "node scripts/oxc-tool.mjs check",
    "check:write": "node scripts/oxc-tool.mjs check:write",
    "check-types": "turbo run check-types",
    "content:validate": "turbo run content:validate",
    "test": "turbo run test",
    "wasm:build": "turbo run wasm:build --filter=@personal-site/web",
    "wasm:dev": "turbo run wasm:dev --filter=@personal-site/web",
    "wasm:setup": "turbo run wasm:setup --filter=@personal-site/web",
    "wasm:watch": "turbo run wasm:watch --filter=@personal-site/web",
    "lint:fix": "node scripts/oxc-tool.mjs lint --fix",
    "test:tools": "node --test scripts/*.test.mjs",
    "verify": "bun run check && bun run test:tools && bun run check-types && bun run test && bun run build"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.90.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "turbo": "2.11.9",
    "ultracite": "8.1.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "bun@1.4.3",
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
