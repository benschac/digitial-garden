{
  "name": "personal-site",
  "private": true,
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "unrs-resolver"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "storybook": "turbo run storybook",
    "build-storybook": "turbo run build-storybook",
    "lint": "turbo run lint",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "check-types": "turbo run check-types",
    "content:validate": "turbo run content:validate",
    "test": "turbo run test",
    "wasm:build": "turbo run wasm:build --filter=@personal-site/web",
    "wasm:dev": "turbo run wasm:dev --filter=@personal-site/web",
    "wasm:setup": "turbo run wasm:setup --filter=@personal-site/web",
    "wasm:watch": "turbo run wasm:watch --filter=@personal-site/web"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "turbo": "2.10.11"
  }
}
