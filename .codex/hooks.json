{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/check-changed.mjs\"",
            "timeout": 60,
            "statusMessage": "Checking Oxfmt formatting and Oxlint on changed files"
          }
        ]
      }
    ]
  }
}
