{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["transit"]
    },
    "check-types": {
      "dependsOn": ["transit"],
      "outputs": [".next/cache/tsconfig.tsbuildinfo"]
    },
    "content:validate": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "wasm:build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!public/wasm/**",
        "$TURBO_ROOT$/packages/wasm-canvas-engine/**"
      ],
      "outputs": ["public/wasm/**"]
    },
    "wasm:dev": {
      "cache": false,
      "persistent": true
    },
    "wasm:setup": {
      "cache": false,
      "interactive": true
    },
    "wasm:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
