{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "!**/*.test.*"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".content-collections/**"
      ],
      "inputs": ["src/**", "package.json", "tsconfig.json", "!**/*.test.*"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT"]
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.{md,mdx,css,html,yaml,yml,toml,png,jpg,jpeg,gif,svg,avif,webp,woff,woff2,ttf,otf,wasm,wgsl,mp4,webm,ico,txt}",
        "package.json",
        "$TURBO_ROOT$/{.oxlintrc.*,oxlint.config.*}",
        "$TURBO_ROOT$/tools/oxlint/**",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/.gitignore"
      ]
    },
    "check-types": {
      "dependsOn": ["transit"],
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    "content:validate": {
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "outputs": [".content-collections/**"]
    },
    "test": {
      "dependsOn": ["transit"],
      "inputs": ["src/**", "package.json", "tsconfig.json"]
    },
    "wasm:build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!public/wasm/**",
        "$TURBO_ROOT$/packages/wasm-canvas-engine/**"
      ],
      "outputs": ["public/wasm/**"]
    },
    "wasm:dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["PORT"]
    },
    "wasm:setup": {
      "cache": false,
      "interactive": true
    },
    "wasm:watch": {
      "cache": false,
      "persistent": true
    },
    "format:check": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!**/*.{png,jpg,jpeg,gif,svg,avif,webp,woff,woff2,ttf,otf,wasm,wgsl,mp4,webm,ico}",
        "$TURBO_ROOT$/{.oxfmtrc.*,oxfmt.config.*}",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/.gitignore"
      ]
    },
    "//#lint:root": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!apps/**",
        "!packages/**",
        "!**/*.{md,mdx,css,html,yaml,yml,toml,png,jpg,jpeg,gif,svg,avif,webp,woff,woff2,ttf,otf,wasm,wgsl,mp4,webm,ico,txt}",
        "$TURBO_ROOT$/{.oxlintrc.*,oxlint.config.*}",
        "$TURBO_ROOT$/tools/oxlint/**",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/.gitignore",
        "!.agent/**",
        "!.agent_sources/**",
        "!.agents/**",
        "!.claude/**",
        "!.codex/**",
        "!.continue/**",
        "!.cursor/**",
        "!.gemini/**",
        "!.opencode/**",
        "!.pi/**",
        "!.roo/**",
        "!.windsurf/**",
        "apps/web/scripts/dev-port.mjs",
        "apps/web/scripts/dev.mjs"
      ]
    },
    "//#format:root": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!apps/**",
        "!packages/**",
        "!tools/oxlint/anti-slop/**",
        "!.agent_sources/**",
        "$TURBO_ROOT$/{.oxfmtrc.*,oxfmt.config.*}",
        "$TURBO_ROOT$/bun.lock",
        ".gitignore",
        "!.agent/**",
        "!.agents/**",
        "!.claude/**",
        "!.codex/**",
        "!.continue/**",
        "!.cursor/**",
        "!.gemini/**",
        "!.opencode/**",
        "!.pi/**",
        "!.roo/**",
        "!.windsurf/**"
      ]
    },
    "//#test:tools": {
      "inputs": [
        "scripts/**",
        "docs/biome-rule-coverage.json",
        "oxlint.config.mts",
        "oxfmt.config.mts",
        "tools/oxlint/**",
        "apps/web/scripts/dev-port.mjs",
        "apps/web/scripts/dev.mjs",
        "apps/web/package.json",
        "packages/*/package.json",
        "package.json",
        "bun.lock",
        "apps/*/turbo.json",
        "packages/*/turbo.json"
      ]
    },
    "test:content": {}
  },
  "cacheDir": ".turbo/cache",
  "futureFlags": {
    "affectedUsingTaskInputs": true
  }
}
