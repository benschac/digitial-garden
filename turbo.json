{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "transit": {
      "dependsOn": ["^transit"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "!.next/dev/**",
        ".content-collections/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "storybook": {
      "cache": false,
      "persistent": true
    },
    "build-storybook": {
      "dependsOn": ["^build"],
      "outputs": ["storybook-static/**"]
    },
    "lint": {
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/scripts/bun-tool.mjs",
        "$TURBO_ROOT$/scripts/bun-tools-version.mjs"
      ]
    },
    "check-types": {
      "dependsOn": ["transit"],
      "outputs": [".next/cache/tsconfig.tsbuildinfo"]
    },
    "content:validate": {
      "dependsOn": ["transit"],
      "outputs": [".content-collections/**"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "wasm:build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "!public/wasm/**",
        "$TURBO_ROOT$/packages/wasm-canvas-engine/**"
      ],
      "outputs": ["public/wasm/**"]
    },
    "wasm:dev": {
      "cache": false,
      "persistent": true
    },
    "wasm:setup": {
      "cache": false,
      "interactive": true
    },
    "wasm:watch": {
      "cache": false,
      "persistent": true
    }
  }
}
